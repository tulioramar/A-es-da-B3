+name: Deploy to Render via Container Image
+
+on:
+  push:
+    branches: [ main ]
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Build and push image to GHCR
+        uses: docker/build-push-action@v4
+        with:
+          context: ./agent
+          push: true
+          tags: ghcr.io/${{ github.repository_owner }}/a-es-da-b3-agent:${{ github.sha }}
+
+      - name: Deploy to Render
+        uses: gh-actions-workflows/deploy-docker-render@v1
+        with:
+          render_api_key: ${{ secrets.RENDER_API_KEY }}
+          service_id: ${{ secrets.RENDER_SERVICE_ID }}
+          image: ghcr.io/${{ github.repository_owner }}/a-es-da-b3-agent:${{ github.sha }}

diff --git a/.github/workflows/deploy-to-cloud-run.yml b/.github/workflows/deploy-to-cloud-run.yml
